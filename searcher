#!/usr/bin/env python3
"""
searcher — find document files by name or content.

Usage:
  searcher [PATH] [QUERY] [options]
  searcher [PATH] --name QUERY
  searcher [PATH] --content QUERY
  searcher [PATH] --name NAME_Q --content CONTENT_Q   (both must match)

Query syntax (content AND name):
  A                  anything containing A
  A B                anything containing A AND B
  A OR B             anything containing A or B
  "A A A"            the exact composed string
  "B B B" "A A A"    must contain both exact strings (AND)
  "B B B" OR "A A A" must contain at least one of them (OR)

  Matching is case-insensitive by default. Use --case-sensitive for exact case.
  A bare word "OR" (any case) is the OR operator — to search the literal
  word "or", quote it: '"or"'.

Supported formats for content search:
  Plain text (no dependency): txt md markdown rst log csv tsv json yaml yml
    toml ini cfg xml html htm xhtml tex org adoc asciidoc + source code
    (py js ts sh java c h cpp go rs rb php css sql ...) read as text.
  Office Open XML via stdlib zip+xml (no dependency): docx pptx xlsx
  OpenDocument via stdlib: odt / ods / odp
  EPUB via stdlib: epub
  RTF via regex stripper (stdlib): rtf
  PDF: uses pypdf if installed, else pdfminer/PyPDF2, else a crude
    stdlib fallback. For best PDF results:  pip install pypdf
  Legacy .doc (OLE binary): not supported — skipped with a warning
    (convert to .docx first). Install LibreOffice for conversion.

Examples:
  searcher . "annual report"
  searcher ~/docs "budget OR forecast"
  searcher ~/docs --name "report 2024"
  searcher ~/docs --content '"quarterly results" OR "annual summary"'
  searcher ~/docs -n invoice -s "paid OR overdue" --ext pdf,docx
  searcher . "TODO" --all-text --no-recursive
"""

import argparse
import os
import re
import sys
import zipfile
import xml.etree.ElementTree as ET
from pathlib import Path
