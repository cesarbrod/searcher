class GuiApp:
    def __init__(self):
        self.app = QApplication(sys.argv)
        self.core = load_core()
        self.settings = load_settings()
        if not self.settings.get("lang"):
            dlg = LanguageDialog()
            if dlg.exec() != QDialog.DialogCode.Accepted:
                sys.exit(0)
            self.settings["lang"] = dlg.selected
            save_settings(self.settings)
        self.wizard: SearchWizard | None = None
        self.results_win: ResultsWindow | None = None

    def _show_wizard(self) -> None:
        if self.wizard is not None:
            self.wizard.close()
        self.wizard = SearchWizard(self.core, self.settings,
                                   self._start_search)
        self.wizard.show()

    def _start_search(self, params: dict) -> None:
        if self.wizard is not None:
            self.wizard.hide()
        query = params["content_q"] or params["name_q"] or ""
        self.results_win = ResultsWindow(
            self.core, self.settings, params, query,
            on_new_search=self._show_wizard,
            on_lang_changed=self._show_wizard)
        self.results_win.show()
        self.results_win.start()

    def run(self) -> int:
        self._show_wizard()
        return self.app.exec()


def self_test() -> int:
    """Headless smoke test (run with QT_QPA_PLATFORM=offscreen)."""
    app = QApplication([])
    core = load_core()
    # 1. translation tables complete?
    keys = set(S["en"])
    for lang in LANGS[1:]:
        missing = keys - set(S[lang])
        extra = set(S[lang]) - keys
        assert not missing, f"{lang} missing keys: {missing}"
        assert not extra, f"{lang} extra keys: {extra}"
    print(f"i18n OK ({len(keys)} keys x {len(LANGS)} langs)")
    # 2. query composer
    assert compose_query("a b", "", "") == "a b"
    assert compose_query("", "x y", "") == "x OR y"
    assert compose_query("", "", "q q") == '"q q"'
    assert compose_query("a", "x y", "p") == 'a "p" x y'
    print("composer OK")
    # 3. real search through core on temp docs
    import tempfile
    tmp = Path(tempfile.mkdtemp(prefix="guitest_"))
    (tmp / "alpha.txt").write_text("Annual Report quarterly results\n")
    (tmp / "beta.md").write_text("budget forecast\n")
    files, _ = core.iter_candidate_files(tmp, True, False,
                                         set(core.DEFAULT_EXTS), 50 * 1024 * 1024)
    assert len(files) == 2, files
    groups = core.parse_query('"quarterly results" OR budget')
    hits, warns, _ = core.search_by_content(
        files, groups, False, 50 * 1024 * 1024, False)
    assert len(hits) == 2, hits
    assert warns == [], warns
    print("core search OK")
    # 4. wizard builds in every language
    settings = load_settings()
    for lang in LANGS:
        settings["lang"] = lang
        wiz = SearchWizard(core, settings, lambda _p: None)
        assert wiz.pageIds(), lang
        wiz.close()
    print("wizard OK (4 languages)")
    # 5. results window + worker end-to-end (offscreen)
    settings["lang"] = "en"
    params = {
        "root": tmp, "recursive": True, "hidden": False,
        "allowed": set(core.DEFAULT_EXTS),
        "max_bytes": 50 * 1024 * 1024,
        "name_q": None, "content_q": "annual",
        "cs": False, "limit": 500, "lines": 3, "verbose_errors": False,
    }
    win = ResultsWindow(core, settings, params, "annual",
                        on_new_search=lambda: None,
                        on_lang_changed=lambda: None)
    worker = SearchWorker(core, params)
    got: dict = {}
    worker.finished.connect(
        lambda r, w, e: got.update(results=r, warnings=w, elapsed=e))
    worker.run()  # synchronous in test
    assert len(got["results"]) == 1, got
    assert got["warnings"] == [], got
    print("worker OK")
    import shutil as _shutil
    _shutil.rmtree(tmp, ignore_errors=True)
    print("ALL GUI SELF-TESTS PASSED")
    return 0


def main(argv: list[str]) -> int:
    if "--self-test" in argv:
        return self_test()
    if "--help" in argv or "-h" in argv:
        print(f"{PROG} {VERSION} — graphical wizard for searcher.\n"
              f"Usage: {PROG} [--self-test]\n"
              f"Needs the 'searcher' program in the same folder and PyQt6.")
        return 0
    return GuiApp().run()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
