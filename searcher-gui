        self.setStatusBar(self.status)

        self._retranslate_toolbar()

    # -- i18n ------------------------------------------------------------
    def tr(self, key: str) -> str:
        lang = self.settings.get("lang") or "en"
        return S.get(lang, S["en"]).get(key, S["en"].get(key, key))

    def _retranslate_toolbar(self) -> None:
        t = self.tr
        self.setWindowTitle(t("r_title"))
        self.act_open.setText(t("r_open"))
        self.act_folder.setText(t("r_folder"))
        self.act_copy.setText(t("r_copy"))
        self.act_save.setText(t("r_save"))
        self.act_new.setText(t("r_new"))
        self.act_cancel.setText(t("r_cancel_search"))

    # -- search lifecycle --------------------------------------------------
    def start(self) -> None:
        t = self.tr
        self.thread = QThread(self)
        self.worker = SearchWorker(self.core, self.params)
        self.worker.moveToThread(self.thread)
        self.thread.started.connect(self.worker.run)
        self.worker.scan_count.connect(
            lambda n: self.status.showMessage(t("r_scanning").format(n=n)))
        self.worker.progress.connect(self._on_progress)
        self.worker.finished.connect(self._on_finished)
        self.worker.failed.connect(self._on_failed)
        for sig in (self.worker.finished, self.worker.failed):
            sig.connect(self.thread.quit)
        self.act_cancel.setEnabled(True)
        self.progress.setVisible(True)
        self.progress.setRange(0, 0)  # busy until totals are known
        self.thread.start()

    def _on_progress(self, done: int, total: int, name: str) -> None:
        t = self.tr
        self.progress.setRange(0, max(1, total))
        self.progress.setValue(done)
        short = name if len(name) <= 40 else "…" + name[-39:]
        self.status.showMessage(t("r_searching").format(
            done=done, total=total) + f" — {short}")

    def _on_finished(self, results: list, warnings: list, elapsed: float) -> None:
        t = self.tr
        self.results, self.warnings = results, warnings
        self.act_cancel.setEnabled(False)
        self.progress.setVisible(False)
        self.list.clear()
        for path, _text in results:
            QListWidgetItem(Path(path).name, self.list).setData(
                Qt.ItemDataRole.UserRole, path)
            self.list.item(self.list.count() - 1).setToolTip(path)
        if results:
            self.list.setCurrentRow(0)
            self.status.showMessage(t("r_summary").format(
                n=len(results), m=self._scanned_hint(), t=elapsed))
        else:
            self.preview.setHtml(f"<i>{self._esc(t('r_none'))}</i>")
            msg = t("r_summary").format(n=0, m=self._scanned_hint(), t=elapsed)
            if warnings:
                msg += " — " + "; ".join(warnings[:2])
            self.status.showMessage(msg)
        self._retranslate_toolbar()

    def _scanned_hint(self) -> int:
        return len(self.results)  # results already limited; show matches basis

    def _on_failed(self, msg: str) -> None:
        self.act_cancel.setEnabled(False)
        self.progress.setVisible(False)
        QMessageBox.warning(self, self.tr("warn_title"), msg)

    def cancel_search(self) -> None:
        if self.worker is not None:
            self.worker.cancelled = True
        if self.thread is not None:
            self.thread.quit()
        self.act_cancel.setEnabled(False)
        self.progress.setVisible(False)
        self.status.showMessage(self.tr("r_cancel_search"))

    # -- result actions ------------------------------------------------------
    def _selected_path(self) -> str | None:
        item = self.list.currentItem()
        return item.data(Qt.ItemDataRole.UserRole) if item else None

    def _selected_text(self) -> str | None:
        path = self._selected_path()
        if path is None:
            return None
        for p, text in self.results:
            if p == path:
                return text
        return None

    @staticmethod
    def _esc(s: str) -> str:
        return (s or "").replace("&", "&amp;").replace("<", "&lt;").replace(
            ">", "&gt;")

    def _show_selected(self) -> None:
        path = self._selected_path()
        text = self._selected_text()
        if path is None:
            return
        if not text:
            self.preview.setHtml(
                f"<b>{self._esc(Path(path).name)}</b><br>{self._esc(path)}")
            return
        groups = self._groups()
        idx = self.core.find_matching_lines(
            text, groups, self.params["cs"])[: max(1, self.params["lines"])]
        lines = text.splitlines()
        terms = sorted({tm for g in groups for tm in g}, key=len, reverse=True)
        html = [f"<b>{self._esc(Path(path).name)}</b>",
                f"<i>{self._esc(path)}</i>", "<br>"]
        for i in idx:
            line = self._esc(lines[i].strip()[:500]) if 0 <= i < len(lines) else ""
            for tm in terms:
                try:
                    line = re.sub(f"({re.escape(self._esc(tm))})",
                                  r"<b>\1</b>", line,
                                  flags=0 if self.params["cs"] else re.IGNORECASE)
                except re.error:
                    pass
            html.append(f"• {line}<br>")
        self.preview.setHtml("\n".join(html))

    def _groups(self) -> list:
        core = self.core
        if self.params["content_q"]:
            return core.parse_query(self.params["content_q"])
        return core.parse_query(self.params["name_q"] or "")

    def open_selected(self) -> None:
        path = self._selected_path()
        if path:
            QDesktopServices.openUrl(QUrl.fromLocalFile(path))

    def reveal_selected(self) -> None:
        path = self._selected_path()
        if path:
            QDesktopServices.openUrl(
                QUrl.fromLocalFile(str(Path(path).parent)))

    def copy_selected(self) -> None:
        path = self._selected_path()
        if path:
            QApplication.clipboard().setText(path)
            self.status.showMessage(self.tr("r_copied"), 3000)

    def save_list(self) -> None:
        t = self.tr
        if not self.results:
            return
        path, _ = QFileDialog.getSaveFileName(
            self, t("r_save_title"), "searcher_results.csv",
            t("r_save_filter"))
        if not path:
            return
        try:
            if path.lower().endswith(".csv"):
                with open(path, "w", newline="", encoding="utf-8") as f:
                    w = csv.writer(f)
                    w.writerow(["file", "preview"])
                    for p, text in self.results:
                        w.writerow([p, (text or "").splitlines()[0][:300]
                                    if text else ""])
            else:
                with open(path, "w", encoding="utf-8") as f:
                    f.write("\n".join(p for p, _ in self.results) + "\n")
        except OSError as e:
            QMessageBox.warning(self, t("warn_title"), str(e))
            return
        QMessageBox.information(
            self, t("r_save_title"),
            t("r_saved").format(n=len(self.results), path=path))

    def _new_search(self) -> None:
        self.cancel_search()
        self.on_new_search()

    def _change_language(self, code: str) -> None:
        self.settings["lang"] = code
        save_settings(self.settings)
        QMessageBox.information(self, self.tr("warn_title"),
                                self.tr("lang_restart_note"))
        self.on_lang_changed()

    def _about(self) -> None:
        QMessageBox.about(self, self.tr("about_title"),
                          self.tr("about_text").format(v=VERSION))

    def closeEvent(self, event) -> None:  # noqa: N802 (Qt naming)
        self.cancel_search()
        super().closeEvent(event)


