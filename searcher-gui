    def _retranslate(self) -> None:
        t = self.tr
        self.setWindowTitle(t("app_title"))
        self.setButtonText(QWizard.WizardButton.NextButton, t("next"))
        self.setButtonText(QWizard.WizardButton.BackButton, t("back"))
        self.setButtonText(QWizard.WizardButton.FinishButton, t("search"))
        self.setButtonText(QWizard.WizardButton.CancelButton, t("cancel"))
        self.page1.setTitle(t("p1_title")); self.page1.setSubTitle(t("p1_sub"))
        self.lbl_folder.setText(t("p1_folder"))
        self.lbl_recent.setText(t("p1_recent"))
        self.btn_browse.setText(t("browse"))
        self.chk_recursive.setText(t("p1_recursive"))
        self.chk_hidden.setText(t("p1_hidden"))
        self.page2.setTitle(t("p2_title")); self.page2.setSubTitle(t("p2_sub"))
        for key, radio in self.preset_radios.items():
            radio.setText(t(f"preset_{key}"))
        self.custom_ext.setPlaceholderText(t("p2_custom_ph"))
        self.page3.setTitle(t("p3_title")); self.page3.setSubTitle(t("p3_sub"))
        self.mode_content.setText(t("mode_content"))
        self.mode_name.setText(t("mode_name"))
        self.mode_both.setText(t("mode_both"))
        self.lbl_all.setText(t("f_all")); self.ed_all.setPlaceholderText(t("f_all_ph"))
        self.lbl_any.setText(t("f_any")); self.ed_any.setPlaceholderText(t("f_any_ph"))
        self.lbl_phrase.setText(t("f_phrase"))
        self.ed_phrase.setPlaceholderText(t("f_phrase_ph"))
        self.chk_advanced.setText(t("f_advanced"))
        self.lbl_query.setText(t("f_query"))
        self.lbl_tip.setText(t("tip_or"))
        self.page4.setTitle(t("p4_title")); self.page4.setSubTitle(t("p4_sub"))
        self.chk_case.setText(t("o_case"))
        self.lbl_max.setText(t("o_maxsize"))
        self.lbl_limit.setText(t("o_limit"))
        self.lbl_lines.setText(t("o_lines"))

    # -- page 1: where ----------------------------------------------------
    def _build_page1(self) -> QWizardPage:
        pg = QWizardPage()
        lay = QVBoxLayout(pg)
        row = QHBoxLayout()
        self.lbl_folder = QLabel()
        self.ed_folder = QLineEdit()
        self.ed_folder.textChanged.connect(lambda _s: pg.completeChanged.emit())
        self.btn_browse = QPushButton()
        self.btn_browse.clicked.connect(self._pick_folder)
        row.addWidget(self.lbl_folder)
        row.addWidget(self.ed_folder, 1)
        row.addWidget(self.btn_browse)
        lay.addLayout(row)
        self.lbl_recent = QLabel()
        self.cb_recent = QComboBox()
        self.cb_recent.setEditable(False)
        self.cb_recent.activated.connect(
            lambda i: self.ed_folder.setText(self.cb_recent.itemText(i)))
        lay.addWidget(self.lbl_recent)
        lay.addWidget(self.cb_recent)
        lay.addStretch(1)
        self.chk_recursive = QCheckBox()
        self.chk_recursive.setChecked(True)
        self.chk_hidden = QCheckBox()
        lay.addWidget(self.chk_recursive)
        lay.addWidget(self.chk_hidden)

        orig_is_complete = pg.isComplete

        def is_complete() -> bool:
            ok = Path(self.ed_folder.text()).expanduser().exists()
            return bool(ok) and orig_is_complete()

        pg.isComplete = is_complete  # type: ignore[method-assign]
        pg.validatePage = lambda: (  # type: ignore[method-assign]
            self._ok_or_warn(Path(self.ed_folder.text()).expanduser().exists(),
                             self.tr("p1_err")))
        return pg

    def _ok_or_warn(self, ok: bool, msg: str) -> bool:
        if not ok:
            QMessageBox.warning(self, self.tr("warn_title"), msg)
        return ok

    def _pick_folder(self) -> None:
        start = self.ed_folder.text() or str(Path.home())
        d = QFileDialog.getExistingDirectory(self, self.tr("p1_folder"), start)
        if d:
            self.ed_folder.setText(d)

    # -- page 2: which files ------------------------------------------------
    def _build_page2(self) -> QWizardPage:
        pg = QWizardPage()
        lay = QVBoxLayout(pg)
        self.preset_radios: dict[str, QRadioButton] = {}
        for key in PRESETS:
            rb = QRadioButton()
            if key == "docs":
                rb.setChecked(True)
            if key == "custom":
                row = QHBoxLayout()
                row.addWidget(rb)
                self.custom_ext = QLineEdit()
                row.addWidget(self.custom_ext, 1)
                lay.addLayout(row)
                rb.toggled.connect(
                    lambda on: self.custom_ext.setEnabled(on))
                self.custom_ext.setEnabled(False)
            else:
                lay.addWidget(rb)
            self.preset_radios[key] = rb
        lay.addStretch(1)
        return pg

    # -- page 3: what to find ----------------------------------------------
    def _build_page3(self) -> QWizardPage:
        pg = QWizardPage()
        lay = QVBoxLayout(pg)
        self.mode_content = QRadioButton(); self.mode_content.setChecked(True)
        self.mode_name = QRadioButton()
        self.mode_both = QRadioButton()
        lay.addWidget(self.mode_content)
        lay.addWidget(self.mode_name)
        lay.addWidget(self.mode_both)
        form = QFormLayout()
        self.lbl_all = QLabel(); self.ed_all = QLineEdit()
        self.lbl_any = QLabel(); self.ed_any = QLineEdit()
        self.lbl_phrase = QLabel(); self.ed_phrase = QLineEdit()
        form.addRow(self.lbl_all, self.ed_all)
        form.addRow(self.lbl_any, self.ed_any)
        form.addRow(self.lbl_phrase, self.ed_phrase)
        lay.addLayout(form)
        self.chk_advanced = QCheckBox()
        self.chk_advanced.toggled.connect(self._toggle_advanced)
        lay.addWidget(self.chk_advanced)
        self.lbl_query = QLabel()
        self.ed_query = QLineEdit()
        self.ed_query.setReadOnly(True)
        lay.addWidget(self.lbl_query)
        lay.addWidget(self.ed_query)
        self.lbl_tip = QLabel()
        self.lbl_tip.setWordWrap(True)
        self.lbl_tip.setStyleSheet("color: gray; font-style: italic;")
        lay.addWidget(self.lbl_tip)
        for ed in (self.ed_all, self.ed_any, self.ed_phrase):
            ed.textChanged.connect(self._refresh_query)
        self._refresh_query()

        orig_is_complete = pg.isComplete

        def is_complete() -> bool:
            return bool(self._effective_query().strip()) and orig_is_complete()

        pg.isComplete = is_complete  # type: ignore[method-assign]
        for ed in (self.ed_all, self.ed_any, self.ed_phrase, self.ed_query):
            ed.textChanged.connect(lambda _s: pg.completeChanged.emit())
        pg.validatePage = lambda: self._ok_or_warn(  # type: ignore[method-assign]
            bool(self._effective_query().strip()), self.tr("p3_err"))
        return pg

    def _toggle_advanced(self, on: bool) -> None:
        self.ed_query.setReadOnly(not on)
        for ed in (self.ed_all, self.ed_any, self.ed_phrase):
            ed.setEnabled(not on)
        if not on:
            self._refresh_query()

    def _refresh_query(self) -> None:
        if not self.chk_advanced.isChecked():
            self.ed_query.setText(compose_query(
                self.ed_all.text(), self.ed_any.text(),
                self.ed_phrase.text()))

    def _effective_query(self) -> str:
        if self.chk_advanced.isChecked():
            return self.ed_query.text()
        return compose_query(self.ed_all.text(), self.ed_any.text(),
                             self.ed_phrase.text())

    # -- page 4: options ----------------------------------------------------
    def _build_page4(self) -> QWizardPage:
        pg = QWizardPage()
        form = QFormLayout(pg)
        self.chk_case = QCheckBox()
        self.spin_max = QSpinBox()
        self.spin_max.setRange(1, 10000)
        self.spin_max.setValue(50)
        self.spin_limit = QSpinBox()
        self.spin_limit.setRange(0, 100000)
        self.spin_limit.setValue(500)
        self.spin_lines = QSpinBox()
        self.spin_lines.setRange(0, 20)
        self.spin_lines.setValue(3)
        self.lbl_max = QLabel(); self.lbl_limit = QLabel(); self.lbl_lines = QLabel()
        form.addRow(self.chk_case)
        form.addRow(self.lbl_max, self.spin_max)
        form.addRow(self.lbl_limit, self.spin_limit)
        form.addRow(self.lbl_lines, self.spin_lines)
        return pg

    # -- restore last session ----------------------------------------------
    def _restore_last(self) -> None:
        last = self.settings.get("last", {})
        folder = last.get("folder") or str(Path.home() / "Documents")
        self.ed_folder.setText(folder)
        recents = [f for f in self.settings.get("recent_folders", []) if f != folder]
        self.cb_recent.clear()
        self.cb_recent.addItems([folder, *recents][:9])
        preset = last.get("preset", "docs")
        if preset in self.preset_radios:
            self.preset_radios[preset].setChecked(True)
        self.custom_ext.setText(last.get("custom_ext", "pdf,docx,txt,md"))
        mode = last.get("mode", "content")
        {"content": self.mode_content, "name": self.mode_name,
         "both": self.mode_both}.get(mode, self.mode_content).setChecked(True)
        self.ed_all.setText(last.get("all_words", ""))
        self.ed_any.setText(last.get("any_words", ""))
        self.ed_phrase.setText(last.get("phrase", ""))
        adv = bool(last.get("advanced", False))
        self.chk_advanced.setChecked(adv)
        if adv:
            self.ed_query.setText(last.get("raw_query", ""))
        self.chk_case.setChecked(bool(last.get("case", False)))
        self.spin_max.setValue(int(last.get("max_size", 50)))
        self.spin_limit.setValue(int(last.get("limit", 500)))
        self.spin_lines.setValue(int(last.get("lines", 3)))
        self.chk_recursive.setChecked(bool(last.get("recursive", True)))
        self.chk_hidden.setChecked(bool(last.get("hidden", False)))
        self._refresh_query()

    def collect(self) -> dict:
        """Gather wizard state + resolve file-type preset to an ext set."""
        core = self.core
        preset = next((k for k, rb in self.preset_radios.items()
                       if rb.isChecked()), "docs")
        custom_raw = self.custom_ext.text()
        if preset == "docs":
            allowed: set[str] | None = set(core.DEFAULT_EXTS)
        elif preset == "pdf":
            allowed = {"pdf"}
        elif preset == "word":
            allowed = {"docx", "odt", "rtf"}
        elif preset == "text":
            allowed = {"txt", "md", "markdown", "rst", "log"}
        elif preset == "sheet":
            allowed = {"xlsx", "pptx", "csv", "tsv", "ods", "odp"}
        elif preset == "code":
            allowed = set(core.DEFAULT_EXTS) | set(core.ALL_TEXT_EXTRA)
        else:
            allowed = core.parse_ext_list(custom_raw) or set(core.DEFAULT_EXTS)
        mode = ("content" if self.mode_content.isChecked()
                else "name" if self.mode_name.isChecked() else "both")
        query = self._effective_query().strip()
        name_q = query if mode in ("name", "both") else None
        content_q = query if mode in ("content", "both") else None
        folder = str(Path(self.ed_folder.text()).expanduser())
        params = {
            "root": Path(folder),
            "recursive": self.chk_recursive.isChecked(),
            "hidden": self.chk_hidden.isChecked(),
            "allowed": allowed,
            "max_bytes": int(self.spin_max.value() * 1024 * 1024),
            "name_q": name_q,
            "content_q": content_q,
            "cs": self.chk_case.isChecked(),
            "limit": self.spin_limit.value(),
            "lines": self.spin_lines.value(),
            "verbose_errors": False,
        }
        # persist for next run
        last = {
            "folder": folder, "preset": preset, "custom_ext": custom_raw,
            "mode": mode, "all_words": self.ed_all.text(),
            "any_words": self.ed_any.text(), "phrase": self.ed_phrase.text(),
            "advanced": self.chk_advanced.isChecked(),
            "raw_query": self.ed_query.text(),
            "case": params["cs"], "max_size": self.spin_max.value(),
            "limit": params["limit"], "lines": params["lines"],
            "recursive": params["recursive"], "hidden": params["hidden"],
        }
        self.settings["last"] = last
        recents = [folder] + [f for f in self.settings.get("recent_folders", [])
                              if f != folder]
        self.settings["recent_folders"] = recents[:8]
        save_settings(self.settings)
        return params

    def _finish_search(self) -> None:
        self.on_search(self.collect())


