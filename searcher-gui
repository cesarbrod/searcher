def load_core():
    """Import the `searcher` script sitting next to this GUI as a module."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    core_path = HERE / "searcher"
    if not core_path.is_file():
        QMessageBox.critical(
            None, PROG,
            f"Could not find the 'searcher' program next to this GUI.\n"
            f"Expected at:\n{core_path}")
        sys.exit(2)
    loader = SourceFileLoader("searcher_core", str(core_path))
    spec = importlib.util.spec_from_loader("searcher_core", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


