            self.addPage(pg)

        self.button(QWizard.WizardButton.FinishButton).clicked.connect(
            self._finish_search)
        self._retranslate()
        self._restore_last()

    # -- i18n helper -----------------------------------------------------
    def tr(self, key: str) -> str:
