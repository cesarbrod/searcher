def load_settings() -> dict:
    try:
        with open(SETTINGS_FILE, encoding="utf-8") as f:
            data = json.load(f)
        merged = dict(DEFAULTS)
        merged.update(data)
        last = dict(DEFAULTS["last"])
        last.update(data.get("last", {}))
        merged["last"] = last
        return merged
    except Exception:
        return {"lang": None,
                "recent_folders": [],
                "last": dict(DEFAULTS["last"])}


def save_settings(settings: dict) -> None:
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        with open(SETTINGS_FILE, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2, ensure_ascii=False)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Query composer (mirrors the core query syntax)
# ---------------------------------------------------------------------------

def compose_query(all_words: str, any_words: str, phrase: str) -> str:
    """Build a core query string from the three beginner fields.

    any-words use OR only when they stand alone; otherwise everything is
    ANDed (predictable, documented in the tip label).
    """
    parts: list[str] = []
    aw = all_words.split()
    if aw:
        parts.append(" ".join(aw))
    ph = phrase.strip()
    if ph:
        parts.append(f'"{ph}"')
    yw = any_words.split()
    if yw:
        if not parts:
            parts.append(" OR ".join(yw))
        else:
            parts.append(" ".join(yw))
    return " ".join(parts)


# ---------------------------------------------------------------------------
# Background search worker (keeps the UI responsive + cancellable)
# ---------------------------------------------------------------------------

class QtProgress:
    """Adapter: core calls .scanning(n) / .searching(d,t,name)."""

    def __init__(self, worker: "SearchWorker"):
        self._w = worker

    def scanning(self, n: int) -> None:
        self._w.scan_count.emit(n)

    def searching(self, done: int, total: int, name: str) -> None:
        if self._w.cancelled:
            raise Cancelled()
        self._w.progress.emit(done, total, name)


class Cancelled(Exception):
    pass


class SearchWorker(QObject):
    scan_count = pyqtSignal(int)
    progress = pyqtSignal(int, int, str)
    finished = pyqtSignal(list, list, float)  # results, warnings, elapsed
    failed = pyqtSignal(str)

    def __init__(self, core, params: dict):
        super().__init__()
        self.core = core
        self.params = params
        self.cancelled = False

    def run(self) -> None:
        t0 = time.perf_counter()
        try:
            p = self.params
            prog = QtProgress(self)
            files, _ = self.core.iter_candidate_files(
                p["root"], p["recursive"], p["hidden"],
                p["allowed"], p["max_bytes"], progress=prog)
            if self.cancelled:
                return
            name_groups = self.core.parse_query(p["name_q"]) if p["name_q"] else []
            content_groups = (self.core.parse_query(p["content_q"])
                              if p["content_q"] else [])
            out: list[tuple[str, str | None]] = []
            warnings: list[str] = []
            if p["content_q"] and p["name_q"]:
                name_hits = {f for f in files
                             if self.core.match_text(f.name, name_groups, p["cs"])}
                subset = [f for f in files if f in name_hits]
                hits, w, _ = self.core.search_by_content(
                    subset, content_groups, p["cs"], p["max_bytes"],
                    p["verbose_errors"], progress=prog)
                warnings.extend(w)
                out = [(str(fp), text) for fp, text in hits]
            elif p["content_q"]:
                hits, w, _ = self.core.search_by_content(
                    files, content_groups, p["cs"], p["max_bytes"],
                    p["verbose_errors"], progress=prog)
                warnings.extend(w)
                out = [(str(fp), text) for fp, text in hits]
            else:
                hits = self.core.search_by_name(files, name_groups, p["cs"])
                out = [(str(fp), None) for fp in hits]
            out.sort(key=lambda r: r[0].lower())
            if p["limit"] and p["limit"] > 0:
                out = out[: p["limit"]]
            self.finished.emit(out, warnings,
                               time.perf_counter() - t0)
        except Cancelled:
            return
        except Exception as e:  # noqa: BLE001 — show it in the UI
            self.failed.emit(str(e))


